# cheval daemon: scheduled syncs, status streams and the HTTP API in one long-running
# service. Use this INSTEAD of cheval.timer (do not enable both).
#
#   systemctl enable --now cheval-daemon
#   systemctl kill -s USR1 cheval-daemon      # start a run now
#
# Needs [daemon] schedule in /etc/cheval/cheval.toml; [status] is optional.
[Unit]
Description=cheval APT mirror daemon (scheduled sync, status streams, HTTP API)
Wants=network-online.target
After=network-online.target
Conflicts=cheval.timer cheval.service

[Service]
Type=simple
User=cheval
ExecStart=/usr/local/bin/cheval -c /etc/cheval/cheval.toml daemon
# Secrets referenced by password_env live here (mode 0600):
EnvironmentFile=-/etc/cheval/secrets.env
# SIGTERM stops a run cleanly: interrupted suites are not published, downloads resume next time.
KillSignal=SIGTERM
TimeoutStopSec=90
Restart=on-failure
RestartSec=30
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/cheval

[Install]
WantedBy=multi-user.target
